PUBLIC_SCHEME=https
PUBLIC_HOST=127.0.0.1

FRONTEND_BIND_HOST=127.0.0.1
FRONTEND_PORT=5173
BACKEND_BIND_HOST=127.0.0.1
BACKEND_PORT=8000
GATEWAY_HTTP_BIND_HOST=0.0.0.0
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_BIND_HOST=0.0.0.0
GATEWAY_HTTPS_PORT=443
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_BIND_HOST=127.0.0.1
REDIS_PORT=6379
MINIO_BIND_HOST=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_BIND_HOST=127.0.0.1
MINIO_CONSOLE_PORT=9001

APT_MIRROR=http://deb.debian.org/debian
APT_SECURITY_MIRROR=http://security.debian.org/debian-security
PIP_INDEX_URL=https://pypi.org/simple
PIP_EXTRA_INDEX_URL=
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
NPM_REGISTRY=https://registry.npmjs.org/

POSTGRES_DB=wisdom_tooth_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

STORAGE_PROVIDER=minio
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=wisdom-tooth-images
MINIO_SECURE=false

JWT_SECRET=change-this-to-a-strong-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

ALLOWED_ORIGINS=https://127.0.0.1,https://localhost,http://127.0.0.1,http://localhost,http://127.0.0.1:5173,http://localhost:5173

OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_SECONDS=120
YOLO_ENABLED=false
YOLO_MODEL_PATH=/models/dental-yolo.pt
YOLO_CONF_THRESHOLD=0.25
YOLO_IMAGE_SIZE=1024
YOLO_DEVICE=
YOLO_CLASS_MAP_JSON=

KAGGLE_USERNAME=
KAGGLE_KEY=

VITE_API_BASE_URL=
