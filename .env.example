PUBLIC_LOGTO_PORT_SUFFIX=:3001
PUBLIC_LOGTO_ADMIN_PORT_SUFFIX=:3002
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=5432
LOGTO_POSTGRES_BIND_HOST=127.0.0.1
